# ============================================================
# SecondBrain DEV Stage – Environment Variables
# Cluster: secondbrain-dev @ 178.104.90.172 (Hetzner / k3s)
# Stand: 18.03.2026
# ============================================================
# ACHTUNG: Sensitive Werte (OPENAI_API_KEY, VAULT_MASTER_KEY)
# müssen als GitHub Secrets gesetzt werden – nicht hier committen!
# ============================================================

# --- PostgreSQL (intern im Cluster) -------------------------
DATABASE_URL=postgresql+asyncpg://secondbrain:devpassword123@postgres.secondbrain-dev.svc.cluster.local:5432/secondbrain

# --- Keycloak -----------------------------------------------
# Interne URL: Backend → Keycloak (Service-Kommunikation)
KEYCLOAK_URL=http://keycloak.secondbrain-dev.svc.cluster.local:8080
# Externe URL: Browser-seitige Redirects (OAuth2)
KEYCLOAK_PUBLIC_URL=https://auth.secondbrain.bathon.business
KEYCLOAK_REALM=secondbrain-dev
KEYCLOAK_CLIENT_ID=backend
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123dev

# --- CORS ---------------------------------------------------
CORS_ORIGINS=["https://app.secondbrain.bathon.business"]

# --- LLM Provider -------------------------------------------
# Echter OPENAI_API_KEY kommt via GitHub Secret, hier nur Platzhalter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder

# --- Vault --------------------------------------------------
# VAULT_MASTER_KEY generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Als GitHub Secret VAULT_MASTER_KEY setzen – nicht im Repo committen!
VAULT_BACKEND=local
VAULT_MASTER_KEY=CHANGE_ME_VIA_GITHUB_SECRET

# --- MCP-Server (intern im Cluster, je Dienst eigener Port) -
MCP_NOTION_URL=http://mcp-notion.secondbrain-dev.svc.cluster.local:3001
MCP_TODOIST_URL=http://mcp-todoist.secondbrain-dev.svc.cluster.local:3002
MCP_GOOGLE_CALENDAR_URL=http://mcp-google-calendar.secondbrain-dev.svc.cluster.local:3003
MCP_OBSIDIAN_URL=http://mcp-obsidian.secondbrain-dev.svc.cluster.local:3004
MCP_ONENOTE_URL=http://mcp-onenote.secondbrain-dev.svc.cluster.local:3005
MCP_ENABLED=true
